# ─────────────────────────────────────────────────────────────
# AI Services Platform — Backend Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
PROJECT_NAME="AI Services Platform"
DEBUG=False

# Random secret used to sign JWTs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# Token lifetime in minutes (default = 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Set True to echo SQL queries in server logs (avoid DEBUG — clashes with system env vars)
APP_DEBUG=False

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_services_platform
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Super-Admin seed user ─────────────────────────────────────
# This account is created automatically on first startup.
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=changethis_to_something_strong

# ── OAuth Providers ───────────────────────────────────────────
# Leave blank for any provider you don't want to enable.

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── AI / GROQ ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192

# ── Email (optional) ──────────────────────────────────────────
EMAILS_ENABLED=False
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=
